# Malgudi Central Sync API — Environment Template
# Copy to .env for local overrides, or configure directly in Render Dashboard.

# Runtime environment (production / development / test)
NODE_ENV=production

# Server network binding (Render sets PORT automatically)
PORT=3000
HOST=0.0.0.0

# Base directory for persistent SQLite WAL database on Render persistent disk
MALGUDI_DATA_DIR=/var/data/malgudi-api

# Secret API key for POS terminal synchronization (REQUIRED in production, minimum 32 characters)
# Generate via: openssl rand -hex 32
MALGUDI_SYNC_API_KEY=your_secure_32_plus_character_api_key_here
