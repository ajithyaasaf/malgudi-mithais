{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Malgudi Mithais POS",
  "version": "2.9.26",
  "identifier": "com.malgudi.pos",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Malgudi Mithais POS - Madurai",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCQ0UxNEZBNDU5OUJFQUUKUldTdXZwbEYraFRPS3hFL3VNWGhQc050NzVIVzRQTGp6M05ZSFRpSGlUSGpudmFuVTI0NGFUUkEK",
      "endpoints": [
        "https://github.com/ajithyaasaf/malgudi-mithais/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}